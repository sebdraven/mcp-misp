# Required.
MISP_URL=https://misp.example.org
MISP_KEY=replace-with-your-api-key

# Defaults shown. Every one of these is validated at startup: an unparseable
# value is a startup failure, not a silent fallback.
MISP_VERIFY_SSL=true
MISP_TIMEOUT=60s
MISP_READONLY=true
MISP_OUT_ROOT=/var/lib/mcp-misp/out
MISP_MAX_CONCURRENCY=4
MISP_MAX_RETRIES=3
# MISP_MAX_RESULTS lowers every result ceiling; it can never raise one.
# MISP_MAX_RESULTS=200

# Local warninglist fallback, used only when the instance does not expose
# POST /warninglists/checkValue.
MISP_WARNINGLIST_LOCAL_FALLBACK=true
MISP_WARNINGLIST_MAX_ENTRIES=200000
MISP_WARNINGLIST_TTL=6h

# Transport. The loopback guard refuses a non-loopback address unless
# MISP_ALLOW_PUBLIC_BIND is set; the container image sets it and moves the
# boundary to the host's published port.
MCP_TRANSPORT=http
MCP_HTTP_ADDR=127.0.0.1:8080
